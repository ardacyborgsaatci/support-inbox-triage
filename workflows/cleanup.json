{
  "name": "Support Triage - Cleanup",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000013",
      "name": "Every Night",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3,
              "triggerAtMinute": 30
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000014",
      "name": "Delete Old Rate Limit Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_DEMO_RATE_LIMIT_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "requestedAt",
              "condition": "lt",
              "keyValue": "={{ $now.minus({ days: 1 }).toISO() }}"
            }
          ]
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000015",
      "name": "Delete Old Log Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_TRIAGE_LOG_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "receivedAt",
              "condition": "lt",
              "keyValue": "={{ $now.minus({ days: 90 }).toISO() }}"
            }
          ]
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "00000000-0000-4000-8000-000000000016",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Housekeeping. Rate-limit rows only matter for the last 24 hours, so older ones are deleted every night. Triage log rows are kept for 90 days.",
        "width": 520,
        "height": 120
      }
    }
  ],
  "connections": {
    "Every Night": {
      "main": [
        [
          {
            "node": "Delete Old Rate Limit Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete Old Rate Limit Rows": {
      "main": [
        [
          {
            "node": "Delete Old Log Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Nightly housekeeping: deletes rate-limit rows older than a day and triage log rows older than 90 days."
  }
}
