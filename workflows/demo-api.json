        "jsCode": "const WINDOW = 30 * 24 * 3600 * 1000;\nconst now = Date.now();\nconst tsOf = (r) => {\n  const t = Date.parse(r.receivedAt || r.createdAt || '');\n  return Number.isFinite(t) ? t : 0;\n};\nconst bool = (v) => v === true || v === 'true';\n// Rows with zero confidence are fallback results (model unavailable); they say nothing about triage quality.\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.category && r.source !== 'eval' && Number(r.confidence) > 0);\nconst recent = rows.filter((r) => now - tsOf(r) < WINDOW);\nconst countBy = (arr, key) => arr.reduce((m, r) => {\n  const v = r[key] || 'unknown';\n  m[v] = (m[v] || 0) + 1;\n  return m;\n}, {});\nconst lat = recent.map((r) => Number(r.latencyMs)).filter((n) => Number.isFinite(n) && n > 0).sort((a, b) => a - b);\n// Only playground and seed rows are listed. Gmail rows are counted but never shown.\nconst listed = recent\n  .filter((r) => r.source === 'playground' || r.source === 'seed')\n  .sort((a, b) => tsOf(b) - tsOf(a))\n  .slice(0, 25)\n  .map((r) => {\n    const item = {\n      at: r.receivedAt || r.createdAt,\n      source: r.source,\n      category: r.category,\n      priority: r.priority,\n      sentiment: r.sentiment,\n      language: r.language,\n      needsHuman: bool(r.needsHuman),\n      injectionSuspected: bool(r.injectionSuspected),\n      status: r.status,\n      latencyMs: Number(r.latencyMs) || 0\n    };\n    if (r.sampleId) {\n      item.sampleId = r.sampleId;\n      item.subject = r.subject;\n      item.summary = r.summary;\n    }\n    return item;\n  });\nreturn [{ json: {\n  generatedAt: new Date().toISOString(),\n  windowDays: 30,\n  total: recent.length,\n  needsHuman: recent.filter((r) => bool(r.needsHuman)).length,\n  injectionFlagged: recent.filter((r) => bool(r.injectionSuspected)).length,\n  medianLatencyMs: lat.length ? lat[Math.floor((lat.length - 1) / 2)] : null,\n  bySource: countBy(recent, 'source'),\n  byCategory: countBy(recent, 'category'),\n  byPriority: countBy(recent, 'priority'),\n  byStatus: countBy(recent, 'status'),\n  recent: listed\n} }];"
      }
    },
