    {
      "id": "00000000-0000-4000-8000-000000000005",
      "name": "Check Limits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const norm = $('Normalize Request').first().json;\nconst VISITOR_LIMIT = 3;\nconst DAILY_LIMIT = 40;\nconst HOUR = 3600 * 1000;\nconst DAY = 24 * HOUR;\nif (norm.source === 'eval') {\n  return [{ json: { allowed: true, reason: '', retryAfterSec: 0, remaining: VISITOR_LIMIT } }];\n}\nconst now = Date.now();\nconst tsOf = (r) => {\n  const t = Date.parse(r.requestedAt || r.createdAt || '');\n  return Number.isFinite(t) ? t : 0;\n};\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.ipHash && r.source !== 'eval');\nconst day = rows.filter((r) => now - tsOf(r) < DAY);\nconst mine = day.filter((r) => r.ipHash === norm.ipHash && now - tsOf(r) < HOUR);\nlet allowed = true;\nlet reason = '';\nlet retryAfterSec = 0;\nif (day.length >= DAILY_LIMIT) {\n  allowed = false;\n  reason = 'daily_cap';\n  const oldest = Math.min(...day.map(tsOf));\n  retryAfterSec = Math.max(60, Math.ceil((oldest + DAY - now) / 1000));\n} else if (mine.length >= VISITOR_LIMIT) {\n  allowed = false;\n  reason = 'visitor_cap';\n  const oldest = Math.min(...mine.map(tsOf));\n  retryAfterSec = Math.max(60, Math.ceil((oldest + HOUR - now) / 1000));\n}\nconst remaining = allowed ? Math.max(0, VISITOR_LIMIT - mine.length - 1) : 0;\nreturn [{ json: { allowed, reason, retryAfterSec, remaining } }];"
      }
    },
