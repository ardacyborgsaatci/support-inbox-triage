    {
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const req = $input.first().json;\nconst b = req.body && typeof req.body === 'object' ? req.body : {};\nconst str = (v, max) => (typeof v === 'string' ? v : '').slice(0, max);\nconst source = b.source === 'eval' ? 'eval' : 'playground';\nconst ipHash = str(b.ipHash, 64).replace(/[^a-zA-Z0-9]/g, '');\nconst sampleRaw = str(b.sampleId, 40);\nconst sampleId = /^[a-z0-9-]{1,32}$/.test(sampleRaw) ? sampleRaw : '';\nconst from = str(b.from, 200).trim();\nconst subject = str(b.subject, 300).trim();\nconst body = typeof b.body === 'string' ? b.body : '';\nlet error = '';\nif (!ipHash) error = 'Missing visitor id.';\nelse if (!from) error = 'Missing sender.';\nelse if (body.length > 4000) error = 'Message is too long (4000 characters max).';\nelse if (!subject && !body.trim()) error = 'Subject or message is required.';\nconst prefix = source === 'eval' ? 'eval-' : 'pg-';\nconst messageId = prefix + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);\nreturn [{ json: { ok: error === '', error, source, ipHash, sampleId, from, subject, body, messageId } }];"
      }
    },
