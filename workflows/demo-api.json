        "jsCode": "const norm = $('Normalize Request').first().json;\nconst r = $('Run Triage Core').first().json;\n// Free-text visitor submissions are never stored: only metadata is kept.\n// Preset samples (sampleId set, verified by the Vercel function) keep their text.\nconst keep = norm.sampleId !== '';\nreturn [{ json: {\n  skip: norm.source === 'eval',\n  source: norm.source,\n  messageId: norm.messageId,\n  sampleId: norm.sampleId,\n  receivedAt: r.receivedAt || new Date().toISOString(),\n  fromDomain: keep ? r.fromDomain || '' : '',\n  subject: keep ? r.subject || '' : '',\n  snippet: keep ? r.snippet || '' : '',\n  category: r.category || 'other',\n  priority: r.priority || 'normal',\n  sentiment: r.sentiment || 'neutral',\n  language: r.language || 'en',\n  summary: keep ? r.summary || '' : '',\n  needsHuman: r.needsHuman === true,\n  humanReason: r.humanReason || '',\n  confidence: Number.isFinite(Number(r.confidence)) ? Number(r.confidence) : 0,\n  injectionSuspected: r.injectionSuspected === true,\n  draftCreated: false,\n  status: r.status || 'needs_review',\n  latencyMs: Number.isFinite(Number(r.latencyMs)) ? Number(r.latencyMs) : 0,\n  promptVersion: r.promptVersion || ''\n} }];"
      }
