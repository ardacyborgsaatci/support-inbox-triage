      "id": "00000000-0000-4000-8000-000000000003",
      "name": "For Support Alias?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
