    {
      "id": "00000000-0000-4000-8000-000000000018",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "content": "Gmail path. Polls the +support alias every minute, runs the shared Triage Core, then: creates a threaded Gmail DRAFT reply (never sends), writes a log row, applies Triage/* labels and, for urgent mail, emails an alert to the owner. There is no node that sends to customers. Run the manual branch below once to create the labels.",
        "width": 700,
        "height": 150
      }
    }
