  "name": "Support Triage - Gmail",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "New Support Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "maxResults": 10,
        "filters": {
          "q": "(deliveredto:YOUR_ADDRESS+support@gmail.com OR to:YOUR_ADDRESS+support@gmail.com) -label:Triage-Processed",
          "readStatus": "both",
          "includeSpamTrash": false,
          "includeDrafts": false
        },
        "options": {
          "downloadAttachments": false
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Prepare Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const m = $input.item.json;\nconst OWNER = 'YOUR_ADDRESS@gmail.com';\nconst ALIAS = 'YOUR_ADDRESS+support@gmail.com';\nconst f = m.from && m.from.value && m.from.value[0] ? m.from.value[0] : {};\nconst address = String(f.address || '').toLowerCase();\nconst name = String(f.name || '').replace(/[\"<>\\r\\n]/g, '').trim();\nconst hdr = m.headers || {};\nconst routedTo = [m.to && m.to.text, hdr['delivered-to'], hdr['x-original-to']].map((x) => String(x || '')).join(' ').toLowerCase();\nconst forSupport = routedTo.includes(ALIAS) && address !== '';\nconst text = typeof m.text === 'string' ? m.text : '';\nconst body = text.trim() ? text : String(m.html || '');\nconst source = address === OWNER ? 'seed' : 'gmail';\nreturn { json: { forSupport, source, sampleId: source === 'seed' ? 'seed' : '', messageId: 'gm-' + m.id, gmailId: m.id, threadId: m.threadId || m.id, fromAddress: address, from: name ? name + ' <' + address + '>' : address, subject: String(m.subject || ''), body } };"
      }
    },
