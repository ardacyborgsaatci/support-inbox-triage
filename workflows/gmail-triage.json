      "name": "Combine Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const r = $input.item.json;\nconst prep = $('Prepare Email').all().map((i) => i.json).find((p) => p.messageId === r.messageId) || {};\nconst base = String(prep.subject || r.subject || '').replace(/^\\s*((re|aw|sv|fwd?)\\s*:\\s*)+/i, '').trim() || '(no subject)';\nconst hasDraft = typeof r.draftReply === 'string' && r.draftReply.trim() !== '' && Boolean(prep.fromAddress);\nreturn { json: { ...r, gmailId: prep.gmailId, threadId: prep.threadId, fromAddress: prep.fromAddress, draftSubject: 'Re: ' + base, hasDraft, draftCreated: hasDraft } };"
      }
