    {
      "id": "00000000-0000-4000-8000-000000000010",
      "name": "Get Gmail Labels",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1680,
        160
      ],
      "parameters": {
        "resource": "label",
        "operation": "getAll",
        "returnAll": true
