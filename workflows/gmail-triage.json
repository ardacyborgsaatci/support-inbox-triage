      "position": [
        240,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const names = ['Triage', 'Triage/Billing', 'Triage/Bug-Report', 'Triage/Account-Access', 'Triage/Feature-Request', 'Triage/Sales-Inquiry', 'Triage/How-To', 'Triage/Spam', 'Triage/Other', 'Triage/P-Urgent', 'Triage/P-High', 'Triage/P-Normal', 'Triage/P-Low', 'Triage/Needs-Human', 'Triage/Injection-Suspected', 'Triage/Processed'];\nreturn names.map((name) => ({ json: { name } }));"
      }
    },
