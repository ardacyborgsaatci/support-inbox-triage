    {
      "id": "00000000-0000-4000-8000-000000000011",
      "name": "Pick Label IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const byName = {};\n$input.all().forEach((i) => { if (i.json && i.json.name && i.json.id) byName[i.json.name] = i.json.id; });\nconst CATS = { billing: 'Billing', bug_report: 'Bug-Report', account_access: 'Account-Access', feature_request: 'Feature-Request', sales_inquiry: 'Sales-Inquiry', how_to: 'How-To', spam: 'Spam', other: 'Other' };\nconst bool = (v) => v === true || v === 'true';\nconst one = (s, n) => String(s || '').replace(/\\s+/g, ' ').trim().slice(0, n);\nconst missing = new Set();\nconst out = [];\n$('Insert Log Row').all().forEach((i) => {\n  const r = i.json;\n  const names = ['Triage/' + (CATS[r.category] || 'Other'), 'Triage/P-' + String(r.priority || 'normal').replace(/^./, (c) => c.toUpperCase())];\n  if (bool(r.needsHuman)) names.push('Triage/Needs-Human');\n  if (bool(r.injectionSuspected)) names.push('Triage/Injection-Suspected');\n  names.push('Triage/Processed');\n  const ids = [];\n  names.forEach((n) => { if (byName[n]) ids.push(byName[n]); else missing.add(n); });\n  const summary = one(r.summary, 160);\n  out.push({ json: { gmailId: String(r.messageId || '').replace(/^gm-/, ''), labelIds: ids, priority: r.priority, category: r.category, urgent: r.priority === 'urgent', alertSubject: '[Support triage] URGENT ' + String(r.category || '').replace(/_/g, ' ') + ': ' + one(summary, 90), alertText: ['An urgent email arrived at the support alias.', '', 'Category: ' + r.category, 'Needs a person: ' + (bool(r.needsHuman) ? 'yes' : 'no'), 'Reason: ' + one(r.humanReason, 200), 'Summary: ' + summary, 'Subject: ' + one(r.subject, 120), '', 'A draft reply (if any) is waiting in Gmail Drafts. Nothing was sent to the customer.'].join('\\n') } });\n});\nif (missing.size > 0) throw new Error('Missing Gmail labels: ' + Array.from(missing).join(', ') + '. Run the Create Triage Labels branch once.');\nreturn out;"
      }
    },
